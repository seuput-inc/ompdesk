{
	"$schema": "https://biomejs.dev/schemas/2.6.8/schema.json",
	"vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": false, "defaultBranch": "main" },
	"files": {
		"includes": [
			"src/**/*.ts",
			"src/**/*.tsx",
			"e2e/**/*.ts",
			"resources/**/*.ts",
			"resources/omp-builtin/**",
			"!resources/omp-builtin/pstack",
			"!resources/gui-bridge/modes/pstack-text.ts",
			"src/main/test-fixtures/*.mjs",
			"scripts/**/*.ts",
			"scripts/**/*.mjs",
			"scripts/**/*.cjs",
			"*.ts",
			"!out",
			"!dist",
			"!node_modules"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"indentWidth": 3,
		"lineWidth": 120,
		"lineEnding": "lf"
	},
	"javascript": {
		"formatter": {
			"semicolons": "always",
			"quoteStyle": "double",
			"trailingCommas": "all",
			"bracketSpacing": true,
			"arrowParentheses": "asNeeded"
		}
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"a11y": "off",
			"correctness": {
				"noUnusedImports": "error",
				"noUnusedVariables": { "level": "warn", "fix": "none" },
				"noVoidTypeReturn": "off"
			},
			"style": {
				"noNonNullAssertion": "off",
				"useConst": "error",
				"useNodejsImportProtocol": "off"
			},
			"suspicious": {
				"noExplicitAny": "warn",
				"noControlCharactersInRegex": "off",
				"noEmptyInterface": "off",
				"noConstEnum": "off",
				"noConfusingVoidType": "off",
				"noArrayIndexKey": "off"
			}
		}
	},
	"overrides": [
		{
			"includes": ["resources/omp-builtin/**/*.md"],
			"formatter": { "enabled": false }
		},
		{
			"includes": [
				"src/renderer/components/chat/work/WorkCrossfade.mount-cost.test.tsx",
				"src/renderer/components/common/Chip.test.tsx",
				"src/renderer/components/common/Modal.test.tsx",
				"src/renderer/components/common/NestedEscape.test.tsx",
				"src/renderer/components/common/Tabs.test.tsx",
				"src/renderer/components/layout/sidebar/Sidebar.test.tsx",
				"src/renderer/components/layout/work-board/WorkBoardChip.test.tsx",
				"src/renderer/components/settings/providers/ProviderPicker.test.tsx",
				"src/renderer/components/settings/settings-data.test.tsx",
				"src/renderer/hooks/use-extension-ui.test.tsx",
				"src/renderer/hooks/use-frame-selector.test.tsx",
				"src/renderer/hooks/use-session-list.test.tsx",
				"src/renderer/hooks/use-shell-mode.test.tsx",
				"src/renderer/hooks/use-stats.test.tsx",
				"src/renderer/hooks/use-usage-reports.test.tsx",
				"src/renderer/lib/now-tick.test.tsx",
				"src/renderer/lib/reveal-focus.test.tsx",
				"src/renderer/lib/tab-runtime-provider.test.tsx",
				"src/renderer/stores/tabs.test.tsx",
				"src/renderer/web/link-status.test.tsx"
			],
			"linter": { "rules": { "correctness": { "noComponentHookFactories": "off" } } }
		},
		{
			"includes": [
				"resources/omp-builtin/ecc/skills/yoruba-localization-testing/examples/localization.mjs",
				"resources/omp-builtin/ecc/skills/yoruba-localization-testing/examples/localization-check.mjs"
			],
			"formatter": { "enabled": false },
			"assist": { "enabled": false }
		}
	],
	"assist": { "actions": { "source": { "organizeImports": "on" } } }
}
