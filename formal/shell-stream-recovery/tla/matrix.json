		{
			"name": "capacity-one-four-events",
			"config": "MC.cfg",
			"constants": {
				"Capacity": "1",
				"MaxEvents": "4"
			},
			"expect": "pass"
		},
		{
			"name": "capacity-two-four-events",
			"config": "MC.cfg",
			"constants": {
				"MaxEvents": "4"
			},
			"expect": "pass"
