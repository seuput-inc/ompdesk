{
  "name": "ompdesk",
  "version": "0.140.0",
  "author": "SeuPut (https://github.com/SeuPut0705)",
  "private": true,
  "type": "module",
  "description": "ompdesk: an unofficial desktop app for the omp coding agent, running on the system-installed omp",
  "repository": "github:seuput-inc/ompdesk",
  "license": "Apache-2.0",
  "main": "./out/main/index.js",
  "scripts": {
    "postinstall": "bun scripts/ensure-electron.ts",
    "dev": "bun scripts/dev.ts",
    "build": "bun scripts/build-cache.ts",
    "package:mac": "bun run build && bun scripts/package-mac.ts",
    "package:win": "bun run build && electron-builder --config electron-builder.win.yml --win --x64",
    "gen:icons": "bun scripts/gen-icons.ts",
    "build:memory": "bun scripts/build-memory.ts",
    "build:native": "bun scripts/build-native.ts",
    "build:shell": "bun scripts/build-shell.ts",
    "build:tauri": "bun scripts/build-tauri.ts",
    "build:node": "bun scripts/build-node.ts",
    "stage:cef-licenses": "bun scripts/stage-cef-licenses.ts",
    "build:agent-desktop": "bun scripts/build-agent-desktop.ts",
    "sync:pstack": "bun scripts/sync-pstack.ts",
    "sync:ecc": "bun scripts/sync-ecc.ts",
    "sync:ponytail": "bun scripts/sync-ponytail.ts",
    "gen:licenses": "bun scripts/generate-third-party-notices.ts",
    "licenses:check": "bun scripts/generate-third-party-notices.ts --check",
    "check": "node scripts/lint-surfaces.mjs && biome check . && bun run check:types",
    "check:types": "bun scripts/build-lock.ts --kind vitest -- tsc --noEmit --incremental --tsBuildInfoFile node_modules/.cache/tsc/check.tsbuildinfo",
    "lint": "biome lint .",
    "fix": "biome check --write --unsafe .",
    "fmt": "biome format --write .",
    "test": "vitest run",
    "test:platform": "vitest run --exclude \"src/renderer/**\"",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "gate": "bun scripts/gate.ts",
    "check:changed": "bun scripts/check-changed.ts",
    "check:release-ci": "bun scripts/ci-run.ts ci -f batch=true -f mac=true -f installer_check=true -f legacy_tag=fixture",
    "locked": "bun scripts/build-lock.ts",
    "lock-stats": "bun scripts/lock-stats.ts",
    "flake": "bun scripts/flake.ts",
    "parity": "bun scripts/parity.ts",
    "bench": "vitest bench",
    "readme:media": "bun scripts/readme-media/run.ts",
    "readme:check": "bun scripts/readme-media/check-readme.ts && bun scripts/readme-media/check-webp.ts",
    "package:win:dir": "bun run build && electron-builder --config electron-builder.win.yml --win --x64 --dir"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/view": "^6.43.15",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@tanstack/react-virtual": "^3.14.26",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "chart.js": "^4.6.1",
    "date-fns": "^4.4.0",
    "diff": "^9.0.0",
    "docx-preview": "0.4.1",
    "electron-log": "^5.4.4",
    "electron-store": "^12.0.0",
    "electron-updater": "^6.8.12",
    "highlight.js": "^11.12.0",
    "jszip": "3.10.2",
    "katex": "0.19.1",
    "lucide-react": "^1.74.0",
    "mermaid": "^12.3.0",
    "micromark-factory-space": "2.1.0",
    "micromark-util-character": "2.1.1",
    "pdfjs-dist": "^6.5.438",
    "qrcode-generator": "^2.0.4",
    "react": "^19.3.1",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.92.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "7.0.0",
    "rehype-sanitize": "6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "6.0.0",
    "ws": "^8.23.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "overrides": {
    "katex": "0.19.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/bun": "^1.4.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@typescript/typescript6": "^6.0.2",
    "axe-core": "4.14.1",
    "electron": "45.3.3",
    "electron-builder": "^26.18.1",
    "electron-vite": "^6.0.0",
    "http_ece": "1.2.1",
    "linkedom": "^0.18.15",
    "micromark-extension-math": "3.1.0",
    "micromark-util-types": "2.0.3",
    "remark-parse": "11.0.0",
    "sharp": "0.35.5",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "unified": "11.0.5",
    "vite": "^7.3.8",
    "vitest": "^5.1.0"
  }
}
